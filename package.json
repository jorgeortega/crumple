{
  "name": "crumple-mcp",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "crumple-mcp": "dist/cli/bin.js",
    "crumple": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "description": "A crumple zone for AI agents: an MCP runtime where every claim is a check you can run.",
  "license": "MIT",
  "author": "October Moon LLC",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "openapi"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prove": "npm run build && node scripts/prove.mjs",
    "test": "vitest run",
    "secrets": "node scripts/secret-scan.mjs",
    "test:coverage": "vitest run --coverage",
    "test:interop": "vitest run --config vitest.interop.config.ts",
    "test:install": "vitest run --config vitest.install.config.ts",
    "test:oldest-node": "npx -y -p node@22.13.1 node node_modules/vitest/vitest.mjs run",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run secrets"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "yaml": "2.9.1"
  }
}
